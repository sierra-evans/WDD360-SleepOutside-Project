---
import '../css/style.css';
import Header from '../components/Header.svelte';
import Footer from '../components/Footer.svelte';
let {title} = Astro.props;

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sleep Outside | {title}</title>
    <script src="../js/main.ts"></script>
  </head>
  <body>
    <Header client:load />
    <slot />
    <!-- Footer has no client-side state yet, so it renders as static HTML. Add client:load when it needs to update in the browser. -->
    <Footer />
  </body>
</html>

